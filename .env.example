SITE_NAME=Fact Feed
SITE_DESCRIPTION=A fact feed app that displays random facts about a variety of topics.
UNSPLASH_ACCESS_KEY=your-unsplash-access-key
UNSPLASH_DISABLED=true
UNSPLASH_URL=https://api.unsplash.com/search/photos
TTS_SERVICE=BROWSER
NEXT_PUBLIC_TTS_SERVICE=<BROWSER|PUTER|POLLY|ELEVENLABS>

# ElevenLabs
ELEVENLABS_API_KEY=<Your ElevenLabs API Key Here>
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_VOICE_IDS=<comma-separated-voice-ids>

# Stripe paywall
NEXT_PUBLIC_PAYWALL_ENABLED=false
STRIPE_SECRET_KEY=<Your Stripe Secret Key Here>
STRIPE_PRICE_ID=<Your Stripe Price ID Here>
NEXT_PUBLIC_APP_URL=<https://your-app-domain.com>